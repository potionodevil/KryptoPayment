# Environment-Variablen für den Krypto Payment Gateway
# Kopiere zu .env und trage reale Werte ein. NIEMALS committen.

# Datenbank
POSTGRES_USER=krypto
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=krypto

# IP-Whitelist für den Edge-Layer UND die App-Ebene (komma-separiert, CIDR möglich)
# Nur diese Quell-IPs dürfen überhaupt Anfragen senden.
IP_WHITELIST=203.0.113.10,198.51.100.0/24

# Chain-RPC-Endpoints (eigene Nodes oder Provider) — nur zum Überwachen/Bestätigen
BTC_RPC_URL=
LTC_RPC_URL=
ETH_RPC_URL=
SOL_RPC_URL=
XMR_RPC_URL=

# Security
HMAC_CLOCK_SKEW_SEC=300
# Pflicht in production: verschlüsselt gespeicherte API-Key-Secrets (AES-256-GCM)
ENCRYPTION_KEY=
